{
  "name": "zerocode",
  "image": "mcr.microsoft.com/devcontainers/php:8.4",
  "containerEnv": {
    "XDEBUG_MODE": "off"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "アプリ",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.live-server"
      ],
      "settings": {
        "files.autoSave": "afterDelay",
        "workbench.startupEditor": "none"
      }
    }
  }
}
